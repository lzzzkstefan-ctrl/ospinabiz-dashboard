# Só os NOMES das variáveis. Nunca coloque valores reais neste arquivo.
# Local: copie para .env.local (fica fora do git) e preencha.
# Produção: Vercel > Project > Settings > Environment Variables.

# ---------- Supabase (Project Settings > API) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secreta, só no servidor. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---------- Relógio (pg_cron do Supabase chamando app/api) ----------
# A mesma senha vai no Vault do Supabase, pra o pg_cron mandar no cabeçalho Authorization.
CRON_SECRET=

# ---------- Meta / WhatsApp: número remetente do monitor ----------
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_TEMPLATE_NAME=
META_TEMPLATE_LANG=

# ---------- Telegram: alertas ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Hubla: webhook de vendas (cabeçalho x-hubla-token) ----------
HUBLA_WEBHOOK_TOKEN=
