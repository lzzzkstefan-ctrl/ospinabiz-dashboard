# Só os NOMES das variáveis. Nunca coloque valores reais neste arquivo.
# Valores locais vão em .env.local (fica fora do git).

# ---------- App Next.js (.env.local e Vercel > Settings > Environment Variables) ----------
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor (convites de usuário). Nunca usar com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---------- Edge Functions (Supabase > Edge Functions > Secrets) ----------
# Número remetente do monitor (BM separada)
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
# App da Meta que assina o webhook
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Template de utilidade aprovado
META_TEMPLATE_NAME=
META_TEMPLATE_LANG=
# Alerta
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
